# ── LLM: cadena primary → fallbacks → heurística ──────────────────
# Patrón Coren: primary on-prem/EU → fallback cloud → heurística degradada.
#
# llm_primary puede ser:
#   scaleway   → Scaleway Generative API (Mistral/Gemma/Llama en París) ✅ EU
#   ollama     → Modelo on-prem (Gemma4 e4b, Llama, Mistral...) ✅ máxima soberanía
#   anthropic  → Claude (no EU sovereign pero hay DPA estándar)
#   deepseek   → DeepSeek API (datos viajan fuera de EU; revisar RGPD)
#
# Configuración por defecto (RECOMENDADA para producción RAI):
#   Mistral Small como primary + Mistral Medium como fallback en Scaleway París.
#   Todo soberano EU, ~€3/mes para 1.000 leads, sin gestión de GPU.
LLM_PRIMARY=scaleway
LLM_FALLBACKS=scaleway

# Scaleway Generative API (París, soberano EU, OpenAI-compatible)
# Catálogo + precios: https://www.scaleway.com/en/pricing/model-as-a-service/
SCALEWAY_API_KEY=
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1
SCALEWAY_MODEL=mistral-small-3.2-24b-instruct-2506
SCALEWAY_FALLBACK_MODEL=mistral-medium-3.5-128b

# Anthropic Claude (NO soberano EU pero excelente quality/tool calling)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# DeepSeek (NO soberano EU; API hospedada fuera de EU)
# Documentación: https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama local. Gemma 4 soporta tool calling (capability: `tools`).
# Tags: https://ollama.com/library/gemma4/tags
#
# Variantes Gemma 4 (todas con visión, 128K ctx en e2b/e4b, 256K en 26b/31b):
#   gemma4:e2b    7.2GB   pequeño y rápido (laptop sin GPU dedicada, M2/M3)
#   gemma4:e4b    9.6GB   = gemma4:latest, balanceado (recomendado para RAI)
#   gemma4:26b    18GB    workstation con GPU 24GB+
#   gemma4:31b    20GB    servidor con GPU 24GB+ (también gemma4:31b-cloud)
#
# Cuantizaciones disponibles para cada tamaño (q4_K_M, q8_0, bf16, MLX, mxfp8,
# nvfp4). Para Mac Apple Silicon usa los tags `-mlx` (ej. gemma4:e4b-mlx).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Circuit breaker (por defecto razonable; rara vez hay que tocarlos)
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30
CIRCUIT_PER_CALL_TIMEOUT_SECONDS=20
CIRCUIT_MIN_CONFIDENCE=0.5

# Twilio (WhatsApp Sandbox)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Handoff
INSTALLER_NOTIFICATION_WEBHOOK=
INSTALLER_WHATSAPP_TO=

# App
DATABASE_PATH=data/rai.db
COMPANY_NAME=Raidasl
PRIVACY_POLICY_URL=https://raidasl.example/privacidad

# Endpoints admin protegidos con cabecera X-Admin-API-Key o ?key=
ADMIN_API_KEY=
