# ── LLM: cadena primary → fallbacks → heurística ──────────────────
# Patrón Coren: Gemma4 on-prem → Gemini fallback. En RAI configurable.
#
# llm_primary puede ser:
#   ollama     → Gemma4 / Llama3 / Qwen local (recomendado para coste/latencia)
#   anthropic  → Claude Sonnet 4.6 (más capaz, vía API)
#   deepseek   → DeepSeek vía API (muy económico)
#
# llm_fallbacks: lista CSV en orden; la heurística degradada se añade siempre al final.
#
# Ejemplos:
#   1) Económico+resiliente: ollama → deepseek → claude_haiku → heurística
#      LLM_PRIMARY=ollama
#      LLM_FALLBACKS=deepseek,anthropic
#   2) Solo cloud: Sonnet → Haiku → heurística
#      LLM_PRIMARY=anthropic
#      LLM_FALLBACKS=anthropic
#   3) Tirando de DeepSeek: deepseek → claude_haiku → heurística
#      LLM_PRIMARY=deepseek
#      LLM_FALLBACKS=anthropic
LLM_PRIMARY=anthropic
LLM_FALLBACKS=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# DeepSeek (API OpenAI-compatible)
# Documentación: https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama local. Gemma 4 soporta tool calling (capability: `tools`).
# Tags: https://ollama.com/library/gemma4/tags
#
# Variantes Gemma 4 (todas con visión, 128K ctx en e2b/e4b, 256K en 26b/31b):
#   gemma4:e2b    7.2GB   pequeño y rápido (laptop sin GPU dedicada, M2/M3)
#   gemma4:e4b    9.6GB   = gemma4:latest, balanceado (recomendado para RAI)
#   gemma4:26b    18GB    workstation con GPU 24GB+
#   gemma4:31b    20GB    servidor con GPU 24GB+ (también gemma4:31b-cloud)
#
# Cuantizaciones disponibles para cada tamaño (q4_K_M, q8_0, bf16, MLX, mxfp8,
# nvfp4). Para Mac Apple Silicon usa los tags `-mlx` (ej. gemma4:e4b-mlx).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Circuit breaker (por defecto razonable; rara vez hay que tocarlos)
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30
CIRCUIT_PER_CALL_TIMEOUT_SECONDS=20
CIRCUIT_MIN_CONFIDENCE=0.5

# Twilio (WhatsApp Sandbox)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Handoff
INSTALLER_NOTIFICATION_WEBHOOK=
INSTALLER_WHATSAPP_TO=

# App
DATABASE_PATH=data/rai.db
COMPANY_NAME=Raidasl
PRIVACY_POLICY_URL=https://raidasl.example/privacidad

# Endpoints admin protegidos con cabecera X-Admin-API-Key o ?key=
ADMIN_API_KEY=
